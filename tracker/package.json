        "deploy": "wrangler deploy",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261027.1",
        "typescript": "^5",
        "wrangler": "^4.153.0"
    }
}
